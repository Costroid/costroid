{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Costroid/costroid/main/cmd/costroid/testdata/objects/egress.schema.json",
  "title": "What costroid egress report --json prints, version 0.1",
  "description": "The outbound calls a ledger's service recorded: one counter for each UTC day, host and outcome. It holds no path, query, header or body.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "costroid.egress/0.1"
    },
    "counters": {
      "description": "One entry for each UTC day, host and outcome, and none when no call has been recorded.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "description": "The UTC day, YYYY-MM-DD.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "host": {
            "description": "The host the call was to.",
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "description": "completed for any answer, failed for no answer, and refused for a call the list stopped before a socket opened.",
            "enum": [
              "completed",
              "failed",
              "refused"
            ]
          },
          "count": {
            "description": "How many calls.",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "day",
          "host",
          "outcome",
          "count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "counters"
  ]
}
