{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Costroid/costroid/main/permissions.schema.json",
  "title": "permissions.json",
  "description": "Every call Costroid makes to GitHub or GitLab under a token, with the page its permissions were read from, every gh and git command it runs, and every permission a recipe's job or the GitHub App asks for, with the calls that need it. docs/permissions.md is the same file for a person to read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calls",
    "steps",
    "local_commands",
    "held",
    "grants"
  ],
  "properties": {
    "calls": {
      "description": "One entry for each method and path Costroid sends to a host.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/call"
      }
    },
    "steps": {
      "description": "A step from another publisher that a recipe runs and that needs a permission of the job's token.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "local_commands": {
      "description": "What Costroid runs through gh or git on the machine it runs on: under the person's own sign-in, which no recipe or App grants, or with none for a public read.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/localCommand"
      }
    },
    "held": {
      "description": "What a token holds without asking for it, and what that rests on.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/held"
      }
    },
    "grants": {
      "description": "What each recipe's job, and the GitHub App, asks of its token.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/grant"
      }
    }
  },
  "$defs": {
    "permissions": {
      "description": "Each permission the call or step needs at the least, and its level. On GitHub the names are a workflow's, so an App's pull_requests is pull-requests. On GitLab, api read is the read_api scope and api write the api scope.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "actions",
          "checks",
          "contents",
          "id-token",
          "metadata",
          "pull-requests",
          "api"
        ]
      },
      "additionalProperties": {
        "enum": [
          "read",
          "write"
        ]
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host",
        "base",
        "method",
        "path",
        "access",
        "permissions",
        "what",
        "why",
        "by",
        "commands"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "host": {
          "enum": [
            "github",
            "gitlab"
          ]
        },
        "base": {
          "description": "What the path follows: api is the host's REST root (api.github.com, GITHUB_API_URL or CI_API_V4_URL), and ACTIONS_ID_TOKEN_REQUEST_URL is the address GitHub Actions gives a job that holds id-token: write.",
          "enum": [
            "api",
            "ACTIONS_ID_TOKEN_REQUEST_URL"
          ]
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PATCH",
            "PUT",
            "DELETE"
          ]
        },
        "path": {
          "description": "The path after the base, without the query. {name} stands for one path segment and {+name} for one or more.",
          "type": "string",
          "pattern": "^(/[^/\\s]+)*$"
        },
        "access": {
          "description": "read changes nothing on the host, and is only ever a GET or a HEAD. write is every other method.",
          "enum": [
            "read",
            "write"
          ]
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "what": {
          "description": "What the call reads or changes, as a short noun phrase.",
          "type": "string",
          "minLength": 1
        },
        "why": {
          "description": "One sentence: why Costroid makes the call.",
          "type": "string",
          "minLength": 1
        },
        "by": {
          "description": "The code that sends the request: a Go function or method, a script of the action, or gh api in a recipe.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "description": "What a recipe or a person runs that makes the call: a costroid command, a script of the action, or gh api.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "What the call's permissions rest on, and the day it was read: the publisher's own page, quoted, or a recorded GitHub Actions run, with what it answered.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "read",
            "says"
          ],
          "properties": {
            "kind": {
              "enum": [
                "page",
                "run"
              ]
            },
            "url": {
              "description": "For a page: its address.",
              "type": "string",
              "pattern": "^https://"
            },
            "run": {
              "description": "For a run: the GitHub Actions run's id.",
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "read": {
              "type": "string",
              "format": "date"
            },
            "says": {
              "description": "For a page, its own words on the permissions; for a run, what each token was answered.",
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "page"
                }
              },
              "required": [
                "url"
              ],
              "not": {
                "required": [
                  "run"
                ]
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "run"
                }
              },
              "required": [
                "run"
              ],
              "not": {
                "required": [
                  "url"
                ]
              }
            }
          ]
        },
        "unverified": {
          "description": "Set where neither a page this file quotes nor a recorded run states the permissions: why they are unverified.",
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "unverified"
          ]
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses",
        "permissions",
        "what",
        "why"
      ],
      "properties": {
        "uses": {
          "description": "The action, owner/name, without its pin.",
          "type": "string"
        },
        "input": {
          "description": "The step needs the permissions only when this input is set.",
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "what": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "description": "What the call's permissions rest on, and the day it was read: the publisher's own page, quoted, or a recorded GitHub Actions run, with what it answered.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "read",
            "says"
          ],
          "properties": {
            "kind": {
              "enum": [
                "page",
                "run"
              ]
            },
            "url": {
              "description": "For a page: its address.",
              "type": "string",
              "pattern": "^https://"
            },
            "run": {
              "description": "For a run: the GitHub Actions run's id.",
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "read": {
              "type": "string",
              "format": "date"
            },
            "says": {
              "description": "For a page, its own words on the permissions; for a run, what each token was answered.",
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "page"
                }
              },
              "required": [
                "url"
              ],
              "not": {
                "required": [
                  "run"
                ]
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "run"
                }
              },
              "required": [
                "run"
              ],
              "not": {
                "required": [
                  "url"
                ]
              }
            }
          ]
        },
        "unverified": {
          "description": "Set where neither a page this file quotes nor a recorded run states the permissions: why they are unverified.",
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "source"
          ]
        },
        {
          "required": [
            "unverified"
          ]
        }
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "token",
        "runs",
        "permissions"
      ],
      "properties": {
        "name": {
          "description": "The recipe and its job, or the GitHub App.",
          "type": "string"
        },
        "file": {
          "description": "The recipe, from the repository's root.",
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "token": {
          "description": "The token the job or the App holds.",
          "type": "string"
        },
        "role": {
          "description": "On GitLab, the role the token's user holds in the project.",
          "type": "string"
        },
        "runs": {
          "description": "Every command, script and step of the grant that makes a call or needs a permission.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "description": "Each permission asked for, its level, and the calls and steps that need it.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "calls",
              "steps"
            ],
            "properties": {
              "level": {
                "enum": [
                  "read",
                  "write"
                ]
              },
              "calls": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "excess": {
                "description": "Set only where the level asked is more than any call or step needs: why it is asked all the same.",
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "localCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "signed_in",
        "access",
        "what",
        "why",
        "by",
        "commands"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "command": {
          "description": "The gh or git command, without its arguments past the subcommand.",
          "type": "string",
          "pattern": "^(gh|git) "
        },
        "signed_in": {
          "description": "Whether the command runs under the person's own sign-in. false is a read of a public repository that signs in to nothing.",
          "type": "boolean"
        },
        "access": {
          "enum": [
            "read",
            "write"
          ]
        },
        "what": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "by": {
          "description": "The files, from the repository's root, that run the command: Go code or a script a release ships.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "held": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "permissions",
        "why",
        "source"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "description": "What the call's permissions rest on, and the day it was read: the publisher's own page, quoted, or a recorded GitHub Actions run, with what it answered.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "read",
            "says"
          ],
          "properties": {
            "kind": {
              "enum": [
                "page",
                "run"
              ]
            },
            "url": {
              "description": "For a page: its address.",
              "type": "string",
              "pattern": "^https://"
            },
            "run": {
              "description": "For a run: the GitHub Actions run's id.",
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "read": {
              "type": "string",
              "format": "date"
            },
            "says": {
              "description": "For a page, its own words on the permissions; for a run, what each token was answered.",
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "page"
                }
              },
              "required": [
                "url"
              ],
              "not": {
                "required": [
                  "run"
                ]
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "run"
                }
              },
              "required": [
                "run"
              ],
              "not": {
                "required": [
                  "url"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
